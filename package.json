{
  "name": "juqode",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "JuQode — AI Coding Workbench for vibe coders",
  "main": "app/main/main.js",
  "scripts": {
    "postinstall:electron": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:all": "npm test",
    "test:e2e": "node tests/e2e/boot.test.mjs && node tests/e2e/visual.mjs && node tests/e2e/offline-shutdown.mjs",
    "pack:linux": "electron-builder --linux dir",
    "pack:win": "electron-builder --win dir zip --x64",
    "test:erd": "node docs/design/check-dbml.mjs",
    "demo": "node scripts/demo/record-demo.mjs",
    "test:unit": "npm run test:erd && node --test --test-timeout=60000 \"tests/*.test.js\""
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.juqode.desktop",
    "productName": "JuQode",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
