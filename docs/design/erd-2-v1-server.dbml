// JuQode — V1 서버 데이터베이스
//
// **아직 없는 것.** 배포(V1)부터 생긴다. Supabase Postgres.
//
// 로컬과 이어지는 유일한 지점은 project.owner_id -> profile.id 인데,
// 데이터베이스가 달라 외래키로 강제되지 않는다. 그래서 이 그림에 그 선은 없다.
// 서버는 클라이언트가 보낸 사용자 ID 를 읽지 않는다 — 로그인 토큰에서 서버가
// 직접 꺼낸 값만 쓴다.
//
// 표기: Note (표 단위) = 시드가 필요한 곳, 신뢰 경계, 부분 인덱스.

Project JuQode_V1_Server {
  database_type: 'PostgreSQL'
}

Table account_role {
  code text [pk]
}

Table account_status {
  code text [pk]
}

Table claude_code_state {
  code text [pk]
}

Table auth_event_kind {
  code text [pk]
}

Table plan_interval {
  code text [pk]
}

Table subscription_status {
  code text [pk]
}

Table payment_status {
  code text [pk]
}

Table audit_kind {
  code text [pk]
}

Table audit_outcome {
  code text [pk]
}

Table engine {
  code text [pk]
  name text [not null]
  paid_by text [not null]
  is_active boolean [not null, default: true]

  Note: '시드 필요: none(엔진 없음 · 규칙과 사실만) · claude_code(paid_by=user) · juqode_hosted(paid_by=juqode). plan.narrative_engine 의 기본값이 none 이고 그 외래키가 restrict 이므로, none 행이 없으면 어떤 plan 도 넣을 수 없다. 결제사(billing_provider)와 다른 것이다 — 이쪽은 추론 엔진이다.'
}

Table auth_users {
  id uuid [pk]
  email text [unique]
  created_at timestamptz [not null]
  last_sign_in_at timestamptz
}

Table profile {
  id uuid [pk]
  email text [not null]
  display_name text
  role text [not null, default: 'member']
  status text [not null, default: 'active']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: '신뢰 경계: 서버는 클라이언트가 보낸 사용자 ID 를 절대 읽지 않는다. 로그인 토큰에서 서버가 직접 꺼낸 값(auth.uid())만 쓴다. 시드 필요: account_role(admin · member) · account_status(active · suspended).'
}

Table device {
  id uuid [pk]
  user_id uuid [not null]
  device_name text
  platform text
  app_version text
  claude_code_state text [not null, default: 'unknown']
  claude_code_checked_at timestamptz
  last_seen_at timestamptz [not null]
  revoked_at timestamptz

  indexes {
    (user_id, last_seen_at)
  }

  Note: '신뢰 경계: 클라이언트가 보낸 device_id 는 그 사용자의 등록 장치인지 서버가 확인한 뒤에만 쓴다. claude_code_state 는 설치·로그인 여부만 담는다 — 자격증명은 서버로 나가지 않는다. 장치는 하드 삭제하지 않고 revoked_at 으로 은퇴시킨다: audit_usage 가 이 행을 참조하고 그것이 사용량 원장이기 때문이다. 시드 필요: claude_code_state(unknown · missing · logged_out · ready).'
}

Table auth_event {
  id uuid [pk]
  user_id uuid [not null]
  device_id uuid [not null]
  kind text [not null]
  ip_hash text
  occurred_at timestamptz [not null]

  indexes {
    (user_id, occurred_at)
  }

  Note: '시드 필요: auth_event_kind(login · logout · refresh · denied).'
}

Table plan {
  code text [pk]
  name text [not null]
  price_krw integer [not null]
  billing_interval text [not null]
  daily_work_limit integer [not null]
  narrative_engine text [not null, default: 'none']
  monthly_narrative_calls integer [not null, default: 0]
  allow_terminal boolean [not null, default: true]
  seat_limit integer [not null, default: 1]
  is_active boolean [not null, default: true]
  sort_ord smallint [not null]

  Note: '무료 등급은 narrative_engine=none 이다 — 프로젝트 읽기의 사실 층(scan.js, 모델 없음)과 Quick Command · 터미널은 그대로 돌고, 여섯 답의 서술 층(narrate.js)만 빠진다. Work(파일 변경)는 사용자 자기 Claude Code 구독으로 도므로 등급이 아니라 device.claude_code_state 가 가른다. 시드 필요: plan_interval(month · year), 그리고 free 등급 한 줄.'
}

Table subscription {
  id uuid [pk]
  user_id uuid [not null]
  plan_code text [not null]
  status text [not null]
  billing_provider text [not null]
  billing_customer_id text
  billing_subscription_id text [unique]
  current_period_start timestamptz [not null]
  current_period_end timestamptz [not null]
  cancel_at_period_end boolean [not null, default: false]
  trial_end_at timestamptz
  canceled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, status)
    (current_period_end)
  }

  Note: '부분 UNIQUE 필요: (user_id) WHERE status = 「active」 — 사용자당 활성 구독 한 건. billing_provider 는 결제사(toss · stripe)이고 engine 과 다른 것이다. 시드 필요: subscription_status(trialing · active · past_due · canceled).'
}

Table payment {
  id uuid [pk]
  subscription_id uuid [not null]
  user_id uuid [not null]
  amount_krw integer [not null]
  status text [not null]
  billing_payment_id text [unique]
  receipt_url text
  paid_at timestamptz
  failed_reason text
  created_at timestamptz [not null]

  indexes {
    (user_id, created_at)
  }

  Note: 'V1 에서는 비어 있다 — 결제를 켤 때 채운다. 시드 필요: payment_status(pending · paid · failed · refunded).'
}

Table billing_webhook {
  id uuid [pk]
  billing_provider text [not null]
  event_id text [not null]
  event_type text [not null]
  payload text [not null]
  processed_at timestamptz
  received_at timestamptz [not null]

  indexes {
    (billing_provider, event_id) [unique]
  }

  Note: 'V1 에서는 비어 있다. 어느 표와도 이어지지 않는다 — 웹훅은 무엇을 바꿀지 알기 전에 도착하고, 처리하면서 subscription · payment 를 찾는다. 멱등 키는 event_id 단독이 아니라 (billing_provider, event_id) 다: 결제사가 다르면 같은 event_id 가 나올 수 있다.'
}

Table policy {
  user_id uuid [pk]
  daily_work_limit_override integer
  narrative_engine_override text
  allow_file_edit boolean [not null, default: true]
  allow_terminal boolean [not null, default: true]
  allow_deploy boolean [not null, default: true]
  updated_at timestamptz [not null]

  Note: '개인 예외. 값이 있으면 plan 을 이기고, null 이면 plan 이 정한다. narrative_engine_override 는 engine.code 와 같은 값 영역이지만 nullable 이라 관계선을 긋지 않는다 — dbdiagram 의 다대일 연산자가 NOT NULL 을 요구한다.'
}

Table usage_day {
  user_id uuid [not null]
  day date [not null]
  works integer [not null, default: 0]
  qc_runs integer [not null, default: 0]
  narrative_calls integer [not null, default: 0]
  updated_at timestamptz [not null]

  indexes {
    (user_id, day) [pk]
  }

  Note: '집계만 담는다. 세 칸 전부 audit_usage 의 행을 먼저 만든 뒤에만 오른다 — 그 표의 (device_id, kind, client_ref) UNIQUE 가 멱등 키다. 이 표 자체에는 멱등 키가 없다.'
}

Table audit_usage {
  id uuid [pk]
  user_id uuid [not null]
  device_id uuid [not null]
  kind text [not null]
  client_ref uuid [not null]
  project_ref text [not null]
  outcome text [not null]
  engine_used text [not null]
  started_at timestamptz [not null]
  ended_at timestamptz

  indexes {
    (device_id, kind, client_ref) [unique]
    (user_id, started_at)
  }

  Note: '사용량 원장. kind 는 usage_day 의 세 칸과 일대일이다(work · qc · narrative). client_ref 는 그 행을 만든 로컬 행의 id — work.id · quick_command_run.id · interpretation.id. (device_id, kind, client_ref) UNIQUE 가 멱등 키이고, 상한 소모는 이 행을 먼저 만든 뒤에만 올린다: 네트워크 재시도가 사용량을 두 번 올리지 못한다. project_ref 는 경로가 아니라 해시다. engine_used 가 none 이면 JuQode 가 낸 비용이 없다는 뜻이다. 시드 필요: audit_kind(work · qc · narrative) · audit_outcome(complete · partial · failed · cancelled · unknown).'
}


// ── 관계 ──
Ref: profile.id - auth_users.id [delete: cascade]
Ref: profile.role > account_role.code
Ref: profile.status > account_status.code
Ref: device.user_id > profile.id [delete: cascade]
Ref: device.claude_code_state > claude_code_state.code
Ref: auth_event.user_id > profile.id [delete: cascade]
Ref: auth_event.device_id > device.id [delete: restrict]
Ref: auth_event.kind > auth_event_kind.code
Ref: subscription.user_id > profile.id [delete: cascade]
Ref: subscription.plan_code > plan.code [delete: restrict]
Ref: subscription.status > subscription_status.code
Ref: plan.narrative_engine > engine.code [delete: restrict]
Ref: plan.billing_interval > plan_interval.code
Ref: payment.subscription_id > subscription.id [delete: cascade]
Ref: payment.user_id > profile.id [delete: cascade]
Ref: payment.status > payment_status.code
Ref: policy.user_id - profile.id [delete: cascade]
Ref: usage_day.user_id > profile.id [delete: cascade]
Ref: audit_usage.user_id > profile.id [delete: cascade]
Ref: audit_usage.device_id > device.id [delete: restrict]
Ref: audit_usage.kind > audit_kind.code
Ref: audit_usage.outcome > audit_outcome.code
Ref: audit_usage.engine_used > engine.code [delete: restrict]

TableGroup "V1 · 룩업" {
  account_role
  account_status
  claude_code_state
  auth_event_kind
  plan_interval
  subscription_status
  payment_status
  audit_kind
  audit_outcome
  engine
}
TableGroup "V1 · 계정" {
  auth_users
  profile
  device
  auth_event
}
TableGroup "V1 · 구독" {
  plan
  subscription
  payment
  billing_webhook
}
TableGroup "V1 · 권한과 사용량" {
  policy
  usage_day
  audit_usage
}
